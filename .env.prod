# ==============================
# 支付模式
# mock：模拟支付
# production：正式支付
# ==============================
PAYMENT_MODE=production

ORDER_PAYMENT_TTL_MINUTES=10
ORDER_EXPIRE_MINUTES=10
PAYMENT_SANDBOX=false

REGISTER_GIFT_PAPER_GENERATION=1
REGISTER_GIFT_POLISH=2
REGISTER_GIFT_EXPORT=1


# ==============================
# 支付宝支付
# ==============================

# 支付宝开放平台应用 APPID
# 获取位置：支付宝开放平台 → 控制台 → 我的应用 → 应用详情
ALIPAY_APP_ID=2021006156688660

# 支付宝网关
# 正式环境使用 openapi.alipay.com
# 沙箱环境使用 openapi-sandbox.dl.alipaydev.com
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 应用私钥：用于你自己的服务端给请求加签
# 推荐使用文件路径方式
ALIPAY_PRIVATE_KEY_PATH=/app/secrets/alipay/app_private_key.pem

# 支付宝公钥：用于服务端验签支付宝异步通知/同步跳转
# 注意：这里是“支付宝公钥”，不是你的“应用公钥”
ALIPAY_PUBLIC_KEY_PATH=/app/secrets/alipay/alipay_public_key.pem

# 支付宝异步通知地址
# 必须是公网可访问地址
# 正式环境建议 https
ALIPAY_NOTIFY_URL=https://lunwentong86.bestshizhongyu.com/api/payment/notify/alipay

# 支付成功后的前端跳转地址
# 只用于页面展示，不能作为入账依据
ALIPAY_RETURN_URL=https://lunwentong86.bestshizhongyu.com/payment/result

# 支付宝卖家 ID，一般可以先留空
ALIPAY_SELLER_ID=

# 签名类型，建议 RSA2
ALIPAY_SIGN_TYPE=RSA2

# 编码
ALIPAY_CHARSET=utf-8
